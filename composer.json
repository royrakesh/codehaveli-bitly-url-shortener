{
    "name": "codehaveli/codehaveli-bitly-url-shortener",
    "description": "Bitly URL Shortener uses the functionality of Bitly API to generate Bitly short link without leaving your WordPress site.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "keywords": ["bitly", "php", "short url", "url shortener", "wordpress plugin"],
    "autoload": {
        "psr-4": {
            "Codehaveli\\Wbitly\\": "src/"
        }
    },
    "autoload-dev": {
  "psr-4": {
    "Codehaveli\\Wbitly\\": "tests/"
  }
},
    "authors": [
        {
            "name": "Rakesh Roy",
            "role": "Developer",
            "email": "royrakesh.cob@gmail.com",
            "homepage": "https://royrakesh.dev"
        }
    ],
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/php-compatibility": "^9.3",
        "slevomat/coding-standard": "^8.19",
        "brain/monkey": "^2.6"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "phpcompat:check": [
            "echo 'Checking PHP 7.4 compatibility...'",
            "@php vendor/bin/phpcs --standard=PHPCompatibility --runtime-set testVersion 7.4 ./src ./codehaveli-bitly-url-shortener.php --extensions=php --report=summary || true",
            "echo 'Checking PHP 8.1 compatibility...'",
            "@php vendor/bin/phpcs --standard=PHPCompatibility --runtime-set testVersion 8.1-8.1 ./src --extensions=php --report=summary || true",
            "echo 'Checking PHP 8.2 compatibility...'",
            "@php vendor/bin/phpcs --standard=PHPCompatibility --runtime-set testVersion 8.2-8.2 ./src --extensions=php --report=summary || true",
            "echo 'Checking PHP 8.3 compatibility...'",
            "@php vendor/bin/phpcs --standard=PHPCompatibility --runtime-set testVersion 8.3-8.3 ./src --extensions=php --report=summary || true",
            "echo 'Checking PHP 8.4 compatibility...'",
            "@php vendor/bin/phpcs --standard=PHPCompatibility --runtime-set testVersion 8.4-8.4 ./src --extensions=php --report=summary || true",
            "echo 'PHP compatibility check completed!'"
        ],
        "phpcompat:7.4": [
            "echo 'Checking PHP 7.4 compatibility...'",
            "@php vendor/bin/phpcs --standard=PHPCompatibility --runtime-set testVersion 7.4 ./src ./codehaveli-bitly-url-shortener.php --extensions=php --report=summary || true",
            "echo 'PHP 7.4 compatibility check completed!'"
        ],
        "phpcs": "phpcs",
        "boom" : [
            "@phpcompat:check",
            "@phpcs"
        ]
    }
}
