<?xml version="1.0"?>
<ruleset name="My Block Plugin Coding Standards">
    <description>PHPCS for WordPress plugin with includes-only checking and vendor exclusion.</description>

 

    <file>src/</file>
    <file>codehaveli-bitly-url-shortener.php</file>
    <!-- Exclude vendor folder -->
    <exclude-pattern>vendor/*</exclude-pattern>

    <!-- WordPress Coding Standards -->
    <rule ref="WordPress" />
    <rule ref="WordPress-Core" />
    <rule ref="WordPress-Extra" />
    <rule ref="WordPress-Docs" /> 

    <!-- Settings -->
    <arg name="tab-width" value="4"/>
    <arg name="extensions" value="php"/>

    <!-- Show progress -->
    <arg value="p"/>
</ruleset>
